angka1_1005 = int(input("Input angka-1: "))
angka2_1005 = int(input("Input angka-2: "))

# Lebih besar dari
hasil = angka1_1005 > angka2_1005
print("\nOperator lebih besar dari")
print("angka1_1005 > angka2_1005 =", hasil)

# Lebih kecil dari
hasil = angka1_1005 < angka2_1005
print("\nOperator lebih kecil dari")
print("angka1_1005 < angka2_1005 =", hasil)

# Lebih besar dari atau sama dengan
hasil = angka1_1005 >= angka2_1005
print("\nOpeartor lebih besar dari atau sama dengan")
print("angka1_1005 >= angka2_1005 =", hasil)

# Lebih kecil dari atau sama dengan
hasil = angka1_1005 <= angka2_1005
print("nOperator lebih kecil dari atau sama dengan")
print("angka1_1005 <= angka2_1005 =", hasil)

# Sama dengan
hasil = angka1_1005 == angka2_1005
print("\nOperator sama dengan")
print("angka1_1005 == angka2_1005 =", hasil)

# Tidak sama dengan 
hasil = angka1_1005 != angka2_1005
print("\nOperator tidak sama dengan")
print("angka1_1005 != angka2_1005 =", hasil)

# Tambahan: perbandingan bertantai dalam Python
hasil = 0 < angka1_1005 < 100
print("\nPerbandingan berantai")
print("0 < angka1_1005 < 100 =", hasil)

hasil = 0 < angka2_1005 < 100
print("o < angka2_1005 < 100 =", hasil)